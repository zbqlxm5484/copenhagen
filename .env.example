# Copy to the untracked .env for Docker Compose.
# bootRun does not load .env automatically; export the same variables in its environment.
# Configuration/schema only: no external clients or payment gate are implemented in this change.

# OpenAI configuration belongs to core-service. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_FRAUD_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=5

# Sift and the detection flag belong to pay-service.
SIFT_API_KEY=
SIFT_ACCOUNT_ID=
SIFT_ENV=sandbox
SIFT_TIMEOUT_SECONDS=3
FRAUD_DETECTION_ENABLED=true

# No policy thresholds are assumed. Leave both blank until calibrated, or set both.
# Sift API scale: 0 <= REVIEW < DENY <= 1 (not console values 0..100).
SIFT_REVIEW_THRESHOLD=
SIFT_DENY_THRESHOLD=
