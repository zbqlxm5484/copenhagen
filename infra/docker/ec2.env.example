# 개발 EC2에서 이 파일을 <DEV_DEPLOY_PATH>/.env로 복사합니다.
# 실제 값을 채운 .env 파일은 절대 commit하지 않습니다.

NGINX_PORT=80

CORE_DB_USER=core
CORE_DB_PASSWORD=CHANGE_ME
PAY_DB_USER=pay
PAY_DB_PASSWORD=CHANGE_ME
MERCHANT_DB_USER=merchant
MERCHANT_DB_PASSWORD=CHANGE_ME

# 아래 image 값은 CI 배포 job이 자동으로 기록하고 갱신합니다.
# CORE_IMAGE=registry.example.com/group/project/core-service:<commit-sha>
# MCP_IMAGE=registry.example.com/group/project/mcp-server:<commit-sha>
# PAY_IMAGE=registry.example.com/group/project/pay-service:<commit-sha>
# MERCHANT_MOCK_IMAGE=registry.example.com/group/project/ucp-merchant-mock:<commit-sha>
# PG_MOCK_IMAGE=registry.example.com/group/project/pg-mock:<commit-sha>
