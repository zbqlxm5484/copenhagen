# Reference only: load_settings reads process environment variables, not this file.
FDS_MODE=MOCK
FDS_OPENAI_MODEL=gpt-5.4-mini

# Leave blank for MOCK. Supply real keys through the runtime secret mechanism.
FDS_OPENAI_API_KEY=
FDS_SIFT_API_KEY=

# Seconds; all three must be explicitly configured for LIVE.
FDS_OPENAI_TIMEOUT_SECONDS=
FDS_SIFT_TIMEOUT_SECONDS=
FDS_EVALUATION_TIMEOUT_SECONDS=

# No production policy or cutoffs are assumed. Set all four together for LIVE.
# Cutoffs: 0 <= medium < high <= 1. These are not console percentages.
FDS_POLICY_VERSION=
FDS_SIFT_MEDIUM_THRESHOLD=
FDS_SIFT_HIGH_THRESHOLD=
FDS_SIFT_SCORE_UNIT=
# The only supported score unit is SIFT_PAYMENT_ABUSE_0_1.
