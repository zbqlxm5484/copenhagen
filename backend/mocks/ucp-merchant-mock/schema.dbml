Project ucp_merchant_mock {
  database_type: 'PostgreSQL'
  Note: '''
  UCP Merchant Mock — 외부 UCP Business 역할의 머천트 서버.
  상품·장바구니·체크아웃·주문의 원본 소유자.
  금액은 전부 minor unit(BIGINT), 통화는 ISO 4217.

  설계서 17개 테이블 → 5개.
  컬럼 감사에서 제외한 것:
    products.seller_name          모든 행이 동일 → application.yml
    checkout_sessions.signed_at   expires_at - 5분으로 계산 가능
    checkout_sessions.credential_token_hash  아무도 안 읽음 → 로그로
    checkout_sessions.payment_resolved_at    감사용, 로그로 충분
    webhook_deliveries.id         webhook_id를 PK로
    webhook_deliveries.target_url 모든 행이 동일 → application.yml
    index ix_checkout_digest      digest로 조회하는 경로가 없음
  '''
}

Enum product_status {
  ACTIVE
  DISCONTINUED
}

Enum cart_status {
  ACTIVE
  CONVERTED
  CANCELED
  EXPIRED
}

Enum checkout_status {
  INCOMPLETE
  REQUIRES_ESCALATION
  READY_FOR_COMPLETE
  COMPLETE_IN_PROGRESS
  COMPLETED
  CANCELED
}

Enum payment_status {
  REQUESTED
  SUCCESS
  FAILED
  UNKNOWN
}

Enum order_status {
  CREATED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

Enum webhook_status {
  PENDING
  DELIVERED
  FAILED
}


Table products {
  id            varchar(36)  [pk]
  external_id   varchar(100) [not null, unique, note: 'UCP 응답에 노출되는 상품 코드']
  title         varchar(255) [not null]
  image_url     varchar(500)
  base_price    bigint       [not null, note: 'minor unit. 옵션 추가금은 variants_json']
  currency      char(3)      [not null]
  status        product_status [not null, default: 'ACTIVE']
  variants_json jsonb        [not null, note: '[{sku, optionName, optionValue, priceDelta, stock, status}]']
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  Note: '''
  옵션(variant)과 재고를 JSONB로 흡수.
  상품 수십 개 규모라 전량 메모리 로드가 조인보다 저렴 — SKU를 키로 Map에 올려 쓴다.
  MVP는 재고를 차감하지 않는다. 품절은 시나리오 API로 stock을 0으로 주입.
  seller_name은 머천트가 하나뿐이라 설정에서 읽는다.
  '''
}


Table carts {
  id            varchar(36)  [pk]
  platform_ref  varchar(100) [unique, note: 'Core가 준 Idempotency-Key. 실제 전달 여부 Core와 확인 필요']
  status        cart_status  [not null, default: 'ACTIVE']
  currency      char(3)      [not null]
  items_json    jsonb        [not null, note: '[{sku, quantity, unitPrice}]']
  expires_at    timestamptz  [not null, note: '만료 워커 없음. PUT/GET 처리 시 검사해 410 반환']
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]

  Note: '''
  UCP 장바구니는 PUT 전체 교체 시맨틱이라 항목별 연산이 존재하지 않는다.
  매번 통째로 갈아끼우므로 cart_items 행 분리가 무의미 → JSONB.
  소계는 items_json에서 계산 — 저장하지 않는다.
  '''
}


Table checkout_sessions {
  id                       varchar(36)  [pk, note: 'Mandate의 business_checkout_id']
  cart_id                  varchar(36)  [not null]
  buyer_ref                varchar(100) [note: '불투명 참조. raw_order_json에 포함시켜 사용']
  status                   checkout_status [not null, default: 'INCOMPLETE']
  currency                 char(3)
  total_amount             bigint       [note: '빠른 비교용 캐시. 어긋나면 canonical_checkout이 진실']
  fulfillment_address      jsonb        [note: 'Core가 준 배송지 스냅샷. 배송비 계산 + 주문에 복사']
  messages_json            jsonb        [note: 'INCOMPLETE 사유 [{code, severity, message, target}]']

  canonical_checkout       text         [note: 'JCS 정규화 결과 문자열. 검증 시 재정규화 금지']
  checkout_digest          varchar(100) [note: 'sha256:<base64url-nopad>. Mandate와 대조']
  merchant_authorization_jws text       [note: 'ES256 Detached JWS. Mandate 내장분과 문자열 대조']
  signing_kid              varchar(100) [note: '키 교체 후에도 옛 체크아웃을 검증하기 위해']
  expires_at               timestamptz  [note: '서명 시각 + 5분']

  completion_key           varchar(255) [unique, note: 'Core가 준 Idempotency-Key']
  completion_request_hash  varchar(64)  [note: '같은 키 + 다른 바디 → 409 CONFLICT']
  completion_response_json jsonb        [note: '재요청 시 결제하지 않고 그대로 재생']

  payment_status           payment_status [note: '워커가 UNKNOWN 건을 이 컬럼으로 스캔']
  pay_payment_id           varchar(100) [note: '결과 기록. 조회 키가 아님 — 조회는 같은 멱등 키 재호출']
  processor_transaction_id varchar(100) [note: 'PG 거래번호']
  payment_error_code       varchar(50)
  payment_attempt_count    int          [not null, default: 0, note: '조회 시도 횟수. 재청구 횟수 아님']
  payment_requested_at     timestamptz  [note: '타임아웃 판단 + 워커 인덱스']

  version                  bigint       [not null, default: 0]
  created_at               timestamptz  [not null, default: `now()`]
  updated_at               timestamptz  [not null, default: `now()`]

  indexes {
    (status, expires_at) [name: 'ix_checkout_expiry']
    (payment_status, payment_requested_at) [name: 'ix_checkout_payment']
  }

  Note: '''
  체크아웃 · 서명 · 멱등 · 결제 네 관심사를 한 행에 담는다.
  Complete 검증이 SELECT 한 방으로 끝나는 것이 목적 — 검증 경로에 조인 0개.

  저장하지 않는 것:
    payment_key            "merchant-checkout-" + id 로 항상 계산 가능
    signed_at              expires_at - 5분
    credential_token_hash  중복은 completion_key가, 재사용은 Pay가 막는다

  payment_status 갱신은 반드시 조건부 UPDATE로:
    UPDATE ... SET payment_status='SUCCESS'
     WHERE id=? AND payment_status='REQUESTED'
  '''
}


Table orders {
  id                  varchar(36)  [pk, note: 'Core에 전달되는 주문번호. GET /orders/{id}의 키']
  checkout_session_id varchar(36)  [not null, unique, note: '중복 주문 최종 방어선']
  status              order_status [not null, default: 'CREATED', note: '변경 시 order.updated 웹훅']
  total_amount        bigint       [not null, note: 'raw_order_json과 중복이나 디버깅 편의']
  currency            char(3)      [not null]
  raw_order_json      jsonb        [not null, note: '주문 조회 응답 · 웹훅 본문 원본. buyer_ref 포함']
  version             bigint       [not null, default: 0, note: '주문 상태가 여러 번 바뀌므로 필요']
  created_at          timestamptz  [not null, default: `now()`]
  updated_at          timestamptz  [not null, default: `now()`]

  Note: '''
  결제 SUCCESS 이후에만 생성. UNKNOWN이면 생성 금지.
  INSERT가 UNIQUE 위반으로 튕기면 기존 주문을 조회해 반환한다 —
  멱등 로직에 버그가 있어도 DB가 중복을 막는다.

  order_items 없음 — raw_order_json에 스냅샷이 이미 있다.
  fulfillment_events 없음 — 상태는 status, 이력은 webhook_deliveries.
  '''
}


Table webhook_deliveries {
  webhook_id      varchar(36)   [pk, note: 'Core의 중복 판별 키. PK를 겸한다']
  order_id        varchar(36)   [not null]
  event_type      varchar(50)   [not null, note: 'order.created / order.updated']
  payload_json    jsonb         [not null, note: '재전송 시 그대로 다시 보냄']
  signature_input text          [note: '마지막 발송 서명 기록. 발송할 때마다 새로 생성한다']
  signature       text
  content_digest  text          [note: 'RFC 9421']
  status          webhook_status [not null, default: 'PENDING']
  attempt_count   int           [not null, default: 0]
  next_attempt_at timestamptz   [note: '지수 백오프']
  response_status int           [note: 'Core 응답 코드. 디버깅용']
  created_at      timestamptz   [not null, default: `now()`]

  indexes {
    (status, next_attempt_at) [name: 'ix_webhook_pending']
    order_id [name: 'ix_webhook_order']
  }

  Note: '''
  order.created / order.updated 발송 큐 겸 이력.
  주문 상태가 여러 번 바뀔 수 있어 orders와 1:N — 컬럼 흡수 불가.

  webhook_id와 payload_json은 재전송 시 반드시 고정한다. 번호를 새로 만들면
  Core가 새 주문으로 오인한다.

  서명은 발송할 때마다 새로 만든다. RFC 9421 서명에 created 시각이 들어가는데
  수신 측이 오래된 서명을 거부하는 것이 일반적이라, 저장분을 재사용하면
  지연 재전송에서 만료로 튕길 수 있다. 컬럼은 마지막 발송 기록용.
  Core가 created 시각을 검사하는지, 허용 오차가 얼마인지 확인할 것.

  target_url은 Core가 하나뿐이라 설정에서 읽는다.
  '''
}


Ref: checkout_sessions.cart_id > carts.id
Ref: orders.checkout_session_id - checkout_sessions.id
Ref: webhook_deliveries.order_id > orders.id


// products ↔ carts / checkout_sessions 사이에는 FK가 없다.
// carts.items_json 과 canonical_checkout 안의 line_items 가
// products.variants_json 의 sku 를 문자열로 참조한다.
// 체크아웃 이후의 상품 정보는 참조가 아니라 서명된 스냅샷이어야 하므로
// FK로 묶으면 오히려 틀린 모델이 된다.


TableGroup catalog {
  products
}

TableGroup transaction {
  carts
  checkout_sessions
}

TableGroup order_outbound {
  orders
  webhook_deliveries
}
